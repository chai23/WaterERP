# WaterERP — Nginx 單一入口（固定 IP、無網域）
# 由 deploy/scripts/generate-nginx-config.ps1 產生，請勿手動改佔位符

server {
    listen 80;
    server_name _;

    # 後台 SPA（根路徑）
    root {{PROJECT_ROOT}}/apps/web-admin/dist;
    index index.html;

    # API 反向代理（僅本機 Node）
    location /api/ {
        proxy_pass http://127.0.0.1:{{API_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # 司機端 SPA（子路徑 /driver/）
    location = /driver {
        return 301 /driver/;
    }

    location /driver/ {
        alias {{PROJECT_ROOT}}/apps/web-driver/dist/;
        index index.html;
        try_files $uri $uri/ /driver/index.html;
    }

    # LINE LIFF 訂水（子路徑 /liff/）
    location = /liff {
        return 301 /liff/;
    }

    location /liff/ {
        alias {{PROJECT_ROOT}}/apps/web-liff/dist/;
        index index.html;
        try_files $uri $uri/ /liff/index.html;
    }

    # 後台 SPA 路由
    location / {
        try_files $uri $uri/ /index.html;
    }
}
