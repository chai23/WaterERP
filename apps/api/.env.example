DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/water_erp"
# 選填：遠端舊庫（唯讀）。未設定時，預設連到與 DATABASE_URL 同主機的 database 庫
# LEGACY_DATABASE_URL="mysql://USER:PASSWORD@遠端IP:3306/database"
PORT=3000
# 正式部署（Nginx 反向代理）建議維持 127.0.0.1，僅本機連線
HOST=127.0.0.1
# 開發模式前端網址；正式環境若走 Nginx 單一入口（同 IP/網域）可省略
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
JWT_SECRET="change-me"
# 選填，例如 7d、24h（見 jsonwebtoken expiresIn）
# JWT_EXPIRES_IN="7d"
