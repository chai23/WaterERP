DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/water_erp"
# 選填：遠端舊庫（唯讀）。未設定時，預設連到與 DATABASE_URL 同主機的 database 庫
# LEGACY_DATABASE_URL="mysql://USER:PASSWORD@遠端IP:3306/database"
PORT=3000
# 正式部署（Nginx 反向代理）建議維持 127.0.0.1，僅本機連線
HOST=127.0.0.1
# 開發模式前端網址；正式環境若走 Nginx 單一入口（同 IP/網域）可省略
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"
JWT_SECRET="change-me"
# 選填，例如 7d、24h（見 jsonwebtoken expiresIn）
# JWT_EXPIRES_IN="7d"

# AI 派單（MVP-A）：預設關閉；開啟後才顯示後台「AI 智慧排程」與相關 API
# DELIVERY_PLANNING_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# GOOGLE_MAPS_API_KEY=

# LINE Messaging API / LIFF（正式部署必填；Webhook: https://你的網址/api/line/webhook）
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_LOGIN_CHANNEL_ID=
# LINE_CHANNEL_ID=
# 正式環境請勿開啟下方開發開關。OTP 預設以 LINE 訊息推播驗證碼（無需簡訊閘道）。
# LIFF_DEV_BYPASS=1
# LINE_OTP_DEV_MODE=1
# 測試用：略過手機驗證碼，僅驗證 LINE 身分＋手機格式（正式上線請刪除）
# LINE_OTP_SKIP=1
