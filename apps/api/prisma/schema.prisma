  deliveryAssignmentId BigInt   @map("delivery_assignment_id") @db.UnsignedBigInt
  salesOrderId         BigInt   @map("sales_order_id") @db.UnsignedBigInt
  salesOrderLineId     BigInt   @map("sales_order_line_id") @db.UnsignedBigInt
