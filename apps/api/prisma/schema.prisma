// 與 database/schema.sql 保持一致；手動建表後執行: npm run prisma:generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  employeeCode String   @unique @map("employee_code") @db.VarChar(50)
  phone        String?  @db.VarChar(32)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(100)
  role         String   @default("dispatcher") @db.VarChar(32)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  driver                   Driver?
  salesOrdersCreated       SalesOrder[]           @relation("SalesOrderCreator")
  productionOrdersCreated  ProductionOrder[]      @relation("ProductionOrderCreator")
  purchaseOrdersCreated    PurchaseOrder[]        @relation("PurchaseOrderCreator")
  stockMovements           StockMovement[]
  assignmentsAssigned      DeliveryAssignment[]   @relation("AssignmentAssigner")
  barrelPickupsCreated     BarrelPickup[]         @relation("BarrelPickupCreator")
  barrelPickupsAssigned    BarrelPickup[]         @relation("BarrelPickupAssigner")
  barrelPickupsSettled     BarrelPickup[]         @relation("BarrelPickupSettler")
  paymentsRecorded         Payment[]              @relation("PaymentRecorder")
  customerLedgerEntries    CustomerLedgerEntry[]
  expenseVouchersCreated   ExpenseVoucher[]       @relation("ExpenseVoucherCreator")
  expenseVouchersVerified  ExpenseVoucher[]       @relation("ExpenseVoucherVerifier")
  barrelMovementsCreated   BarrelMovement[]       @relation("BarrelMovementCreator")
  serviceTicketsAccepted   ServiceTicket[]        @relation("ServiceTicketAcceptor")
  serviceTicketsAssessAssigned ServiceTicket[]    @relation("ServiceTicketAssessAssigner")
  serviceTicketsWorkshopUpdated ServiceTicket[]   @relation("ServiceTicketWorkshopUpdater")
  serviceTicketsReturnAssigned ServiceTicket[]    @relation("ServiceTicketReturnAssigner")
  serviceTicketEventsCreated ServiceTicketEvent[] @relation("ServiceTicketEventCreator")
  customerLifecycleEventsRecorded CustomerLifecycleEvent[] @relation("CustomerLifecycleRecorder")
  operationAuditLogs              OperationAuditLog[]      @relation("OperationAuditActor")
  lineBindChallengesCreated       LineBindChallenge[]      @relation("LineBindChallengeCreator")
  dayCloseLocksLocked             DayCloseLock[]           @relation("DayCloseLocker")
  dayCloseLocksUnlocked           DayCloseLock[]           @relation("DayCloseUnlocker")
  deliveryPlansCreated            DeliveryPlan[]           @relation("DeliveryPlanCreator")
  deliveryPlansApproved           DeliveryPlan[]           @relation("DeliveryPlanApprover")
  deliveryPlanningSettingsUpdated DeliveryPlanningSetting[] @relation("DeliveryPlanningSettingUpdater")
  deliveryPlanningAuditLogs       DeliveryPlanningAuditLog[] @relation("DeliveryPlanningAuditActor")

  @@map("users")
}

model Vehicle {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  plateNo     String   @unique @map("plate_no") @db.VarChar(20)
  description String?  @db.VarChar(200)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  drivers             Driver[]
  deliveryAssignments DeliveryAssignment[]
  deliveryRoutes      DeliveryRoute[]
  barrelPickups       BarrelPickup[]
  barrelMovements     BarrelMovement[]
  serviceTicketsAssess ServiceTicket[] @relation("ServiceTicketAssessVehicle")
  serviceTicketsReturn ServiceTicket[] @relation("ServiceTicketReturnVehicle")

  @@map("vehicles")
}

model Driver {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt   @unique @map("user_id") @db.UnsignedBigInt
  vehicleId     BigInt?  @map("vehicle_id") @db.UnsignedBigInt
  employeeCode  String?  @map("employee_code") @db.VarChar(50)
  maxOrderCount Int      @default(20) @map("max_order_count") @db.UnsignedInt
  maxBarrelQty  Int      @default(150) @map("max_barrel_qty") @db.UnsignedInt
  /// AI 派單：預設上班時間（可空；不影響既有人工派單）
  workStartTime DateTime? @map("work_start_time") @db.Time(0)
  workEndTime   DateTime? @map("work_end_time") @db.Time(0)
  depotLatitude  Decimal? @map("depot_latitude") @db.Decimal(10, 7)
  depotLongitude Decimal? @map("depot_longitude") @db.Decimal(10, 7)
  familiarZoneIdsJson Json? @map("familiar_zone_ids_json")
  canHighFloor Boolean? @map("can_high_floor")
  /// 月基本底薪（薪資統計用）
  baseSalary    Decimal  @default(0) @map("base_salary") @db.Decimal(14, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user        User                 @relation(fields: [userId], references: [id])
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id])
  assignments DeliveryAssignment[]
  barrelPickups BarrelPickup[]
  floorBonusRecords FloorDeliveryBonusRecord[]
  barrelMovements BarrelMovement[]
  serviceTicketsAssess ServiceTicket[] @relation("ServiceTicketAssessDriver")
  serviceTicketsReturn ServiceTicket[] @relation("ServiceTicketReturnDriver")
  serviceTicketsCollect ServiceTicket[] @relation("ServiceTicketCollectorDriver")
  attendanceRecords DriverAttendance[]
  deliveryRoutes DeliveryRoute[]
  preferredForOrders SalesOrder[] @relation("OrderPreferredDriver")
  requiredForOrders  SalesOrder[] @relation("OrderRequiredDriver")

  @@map("drivers")
}

/// 司機當日出勤（AI 派單；不改 is_active 語意）
model DriverAttendance {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  driverId      BigInt    @map("driver_id") @db.UnsignedBigInt
  workDate      DateTime  @map("work_date") @db.Date
  /// am | pm | all（舊資料 all＝全日）
  shift         String    @default("all") @db.VarChar(8)
  isOnDuty      Boolean   @default(true) @map("is_on_duty")
  workStartTime DateTime? @map("work_start_time") @db.Time(0)
  workEndTime   DateTime? @map("work_end_time") @db.Time(0)
  note          String?   @db.VarChar(500)
  /// 本班主跑區域 AddressZone id 陣列（僅該日該班）
  runZoneIdsJson Json?    @map("run_zone_ids_json")
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, workDate, shift], map: "uk_driver_attendance_date_shift")
  @@index([workDate], map: "idx_driver_attendance_date")
  @@map("driver_attendance")
}

model AddressZone {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @unique @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customers Customer[]

  @@map("address_zones")
}

model AffiliatedCompany {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @unique @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customers Customer[]
  expenseVouchers ExpenseVoucher[]

  @@map("affiliated_companies")
}

model PrintSlogan {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title     String   @unique @db.VarChar(80)
  body      String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("print_slogans")
}

/// 訂單套印公告（全站常態 + 特定期間）
model OrderAnnouncement {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title     String    @db.VarChar(80)
  body      String    @db.Text
  /// standing | period
  kind      String    @default("standing") @db.VarChar(16)
  startsOn  DateTime? @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([kind, isActive])
  @@index([startsOn, endsOn])
  @@map("order_announcements")
}

model Customer {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// 客戶編號（6 碼數字，可由人員自行指定）
  customerCode   String?  @unique @map("customer_code") @db.Char(6)
  name           String   @db.VarChar(200)
  contactName    String?  @map("contact_name") @db.VarChar(100)
  phone          String?  @db.VarChar(32)
  mobile         String?  @db.VarChar(32)
  taxId          String?  @map("tax_id") @db.VarChar(8)
  /// cash | monthly | prepaid
  billingType    String   @default("cash") @map("billing_type") @db.VarChar(32)
  /// none | tax_inclusive | tax_exclusive；開單預設現金發票模式
  defaultCashInvoiceMode String? @default("none") @map("default_cash_invoice_mode") @db.VarChar(32)
  addressZoneId         BigInt?  @map("address_zone_id") @db.UnsignedBigInt
  affiliatedCompanyId   BigInt?  @map("affiliated_company_id") @db.UnsignedBigInt
  creditLimit    Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  notes          String?  @db.Text
  /// 客戶常態備註（列印、開單參考）
  standingRemark String?  @map("standing_remark") @db.Text
  /// 已廢止寫入；API 回傳時為各送貨地址 barrels_on_site 加總（相容舊欄位）
  barrelsOnSite  Int      @default(0) @map("barrels_on_site")
  /// 月結客戶：每月幾號為結帳／對帳參考日（1–31）
  monthlySettlementDay Int? @map("monthly_settlement_day")
  /// 預付客戶：可用桶數餘額（與 ledger 同步維護）
  prepaidBarrelBalance Int @default(0) @map("prepaid_barrel_balance")
  /// 預付不足時是否仍允許核銷（透支）
  allowPrepaidOverdraft Boolean @default(false) @map("allow_prepaid_overdraft")
  /// LINE Messaging API userId（LIFF 綁定後寫入；唯一）
  lineUserId     String?   @unique @map("line_user_id") @db.VarChar(64)
  lineBoundAt    DateTime? @map("line_bound_at") @db.DateTime(3)
  /// active | churned
  lifecycleStatus  String    @default("active") @map("lifecycle_status") @db.VarChar(24)
  /// 決定不再服務日
  churnedAt        DateTime? @map("churned_at") @db.Date
  churnReasonId    BigInt?   @map("churn_reason_id") @db.UnsignedBigInt
  churnReasonNote  String?   @map("churn_reason_note") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  addressZone       AddressZone?       @relation(fields: [addressZoneId], references: [id], onDelete: SetNull)
  affiliatedCompany AffiliatedCompany? @relation(fields: [affiliatedCompanyId], references: [id], onDelete: SetNull)
  churnReason       CustomerChurnReason? @relation(fields: [churnReasonId], references: [id], onDelete: SetNull)
  addresses   DeliveryAddress[]
  salesOrders SalesOrder[]
  payments    Payment[]
  ledgerEntries CustomerLedgerEntry[]
  arDocuments ArDocument[]
  arOpenItems ArOpenItem[]
  receiptVouchers ReceiptVoucher[]
  prepaymentWallet CustomerPrepaymentWallet?
  prepaymentTxns PrepaymentTxn[]
  notificationLogs NotificationLog[]
  prepaidProductBalances CustomerPrepaidProductBalance[]
  creditNotes CreditNote[]
  billingStatements BillingStatement[]
  taxInvoices       TaxInvoice[]
  barrelPickups     BarrelPickup[]
  expenseLines      ExpenseLine[]
  barrelMovements   BarrelMovement[]
  serviceTickets    ServiceTicket[]
  lifecycleEvents   CustomerLifecycleEvent[]
  lineBindChallenges LineBindChallenge[]

  @@index([lifecycleStatus, churnedAt])
  @@map("customers")
}

model CustomerChurnReason {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique @db.VarChar(40)
  label     String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customers       Customer[]
  lifecycleEvents CustomerLifecycleEvent[]

  @@map("customer_churn_reasons")
}

model CustomerLifecycleEvent {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId       BigInt    @map("customer_id") @db.UnsignedBigInt
  /// created | churned | reactivated
  eventType        String    @map("event_type") @db.VarChar(24)
  effectiveAt      DateTime  @map("effective_at") @db.Date
  churnReasonId    BigInt?   @map("churn_reason_id") @db.UnsignedBigInt
  note             String?   @db.VarChar(500)
  recordedByUserId BigInt?   @map("recorded_by_user_id") @db.UnsignedBigInt
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  churnReason CustomerChurnReason? @relation(fields: [churnReasonId], references: [id], onDelete: SetNull)
  recordedBy  User?                @relation("CustomerLifecycleRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, effectiveAt])
  @@index([eventType, effectiveAt])
  @@map("customer_lifecycle_events")
}

/// 客戶預付桶（按商品分帳）：僅可用於同商品之預付出貨
model CustomerPrepaidProductBalance {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  customerId    BigInt   @map("customer_id") @db.UnsignedBigInt
  productId     BigInt   @map("product_id") @db.UnsignedBigInt
  balanceBarrels Int     @default(0) @map("balance_barrels")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("customer_prepaid_product_balances")
}

model DeliveryAddress {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  customerId    BigInt   @map("customer_id") @db.UnsignedBigInt
  label         String?  @db.VarChar(100)
  addressLine   String   @map("address_line") @db.VarChar(500)
  /// 送貨樓層（1=一樓, 2=二樓, -1=地下一樓；null=未設定）
  deliveryFloor Int?     @map("delivery_floor") @db.SmallInt
  contactName   String?  @map("contact_name") @db.VarChar(100)
  contactPhone  String?  @map("contact_phone") @db.VarChar(32)
  contactMobile String?  @map("contact_mobile") @db.VarChar(32)
  notes         String?  @db.Text
  /// AI 派單地理（可空；人工派單不依賴）
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  geocodeStatus String   @default("pending") @map("geocode_status") @db.VarChar(32)
  geocodedAddress String? @map("geocoded_address") @db.VarChar(500)
  geocodedAt    DateTime? @map("geocoded_at") @db.DateTime(3)
  locationAccuracy String? @map("location_accuracy") @db.VarChar(32)
  manualLocationConfirmed Boolean @default(false) @map("manual_location_confirmed")
  isDefault     Boolean  @default(false) @map("is_default")
  /// 此送貨點未收回空桶數：核銷送達時依押桶商品與回桶數自動增減，亦可手動調整
  barrelsOnSite Int      @default(0) @map("barrels_on_site")
  /// 巡查星期（相容欄）：1=週一 … 7=週日；多天時存第一天；null=不參加週期巡查
  patrolWeekday Int?     @map("patrol_weekday") @db.UnsignedTinyInt
  /// 巡查頻率：1=每週、2/3/4=每N週；null=不參加
  patrolIntervalWeeks Int? @map("patrol_interval_weeks") @db.UnsignedTinyInt
  /// 巡查星期，逗號分隔 1=週一…7=週日
  patrolWeekdays String? @map("patrol_weekdays") @db.VarChar(16)
  /// 頻率>=2 的起始週週一
  patrolCycleAnchor DateTime? @map("patrol_cycle_anchor") @db.Date
  /// 目標水位（桶）：現場不足時補到此量（實際桶數於配送回報填）
  targetWaterLevel Int?  @map("target_water_level") @db.UnsignedInt
  /// 巡查預設商品（一鍵產生巡查單用）；結帳方式仍依客戶 billingType
  patrolProductId BigInt? @map("patrol_product_id") @db.UnsignedBigInt
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customer      Customer @relation(fields: [customerId], references: [id])
  patrolProduct Product? @relation(fields: [patrolProductId], references: [id], onDelete: SetNull)
  salesOrders   SalesOrder[]
  barrelPickups BarrelPickup[]
  barrelMovements BarrelMovement[]
  serviceTickets ServiceTicket[]

  @@index([patrolWeekday], map: "idx_addr_patrol_weekday")
  @@index([geocodeStatus], map: "idx_addr_geocode_status")
  @@map("delivery_addresses")
}

model Product {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// 商品編號（3 碼數字，可由人員自行指定）
  productCode String? @unique @map("product_code") @db.Char(3)
  sku       String?  @unique @db.VarChar(50)
  name      String   @db.VarChar(200)
  unit      String   @default("桶") @db.VarChar(20)
  /// 核銷送達時是否將該品項數量計入客戶「未收回空桶」（與單位無關）
  countsDepositBarrel Boolean @default(false) @map("counts_deposit_barrel")
  /// 預付結帳（prepaid）列出貨時是否自預付桶餘額扣桶（與計入押桶無關）
  consumesPrepaidBarrel Boolean @default(false) @map("consumes_prepaid_barrel")
  /// 是否顯示於 LINE LIFF 客戶訂水選單（預設否）
  availableOnLiff Boolean @default(false) @map("available_on_liff")
  salePrice Decimal  @default(0) @map("sale_price") @db.Decimal(14, 2)
  costPrice Decimal  @default(0) @map("cost_price") @db.Decimal(14, 2)
  /// 司機每單位配送薪資（月薪統計用）
  driverDeliveryWage Decimal @default(0) @map("driver_delivery_wage") @db.Decimal(14, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  inventory            InventoryBalance?
  salesOrderLines      SalesOrderLine[]
  productionLines      ProductionOrderLine[]
  stockMovements       StockMovement[]
  purchaseOrderLines   PurchaseOrderLine[]
  prepaidCustomerBalances CustomerPrepaidProductBalance[]
  floorBonusRecords       FloorDeliveryBonusRecord[]
  dispenserGiftRulesAsTrigger PromotionDispenserGiftRule[] @relation("DispenserGiftTrigger")
  dispenserGiftRulesAsGift    PromotionDispenserGiftRule[] @relation("DispenserGiftProduct")
  patrolDeliveryAddresses DeliveryAddress[]

  @@map("products")
}

/// 薪資費率設定（單列 id=1）
model PayrollSetting {
  id               BigInt   @id @default(1) @db.UnsignedBigInt
  /// 回收空桶每桶薪資（固定）
  emptyBarrelWage  Decimal  @default(0) @map("empty_barrel_wage") @db.Decimal(14, 2)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("payroll_settings")
}

/// 上樓搬運獎金：依樓層單價（floor 與 FloorDeliveryBonusRecord.floor 相同語意）
model PayrollFloorBonusRate {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  floor     Int      @unique @db.SmallInt
  wage      Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("payroll_floor_bonus_rates")
}

/// 客戶樓層搬運費（向客戶收費；與司機獎金分離）
model CustomerFloorFeeRate {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  floor     Int      @unique @db.SmallInt
  unitPrice Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("customer_floor_fee_rates")
}

/// 優惠活動主檔（各類型開關與參數）
model PromotionRule {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ruleKey     String   @unique @map("rule_key") @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  isEnabled   Boolean  @default(false) @map("is_enabled")
  config      Json
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("promotion_rules")
}

/// 購買飲水機贈商品：每種飲水機一筆規則
model PromotionDispenserGiftRule {
  id               BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  triggerProductId BigInt  @map("trigger_product_id") @db.UnsignedBigInt
  giftProductId    BigInt  @map("gift_product_id") @db.UnsignedBigInt
  giftQtyPerUnit   Int     @default(1) @map("gift_qty_per_unit")
  isActive         Boolean @default(true) @map("is_active")
  sortOrder        Int     @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  triggerProduct Product @relation("DispenserGiftTrigger", fields: [triggerProductId], references: [id])
  giftProduct    Product @relation("DispenserGiftProduct", fields: [giftProductId], references: [id])

  @@unique([triggerProductId], map: "uk_dispenser_gift_trigger")
  @@map("promotion_dispenser_gift_rules")
}

model SalesOrder {
  id                     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  orderNo                String    @unique @map("order_no") @db.VarChar(40)
  customerId             BigInt    @map("customer_id") @db.UnsignedBigInt
  deliveryAddressId      BigInt    @map("delivery_address_id") @db.UnsignedBigInt
  status                 String    @default("draft") @db.VarChar(32)
  scheduledDeliveryDate  DateTime? @map("scheduled_delivery_date") @db.Date
  /// AI 派單時窗（全可空；未填=無硬時窗）
  deliveryWindowStart    DateTime? @map("delivery_window_start") @db.Time(0)
  deliveryWindowEnd      DateTime? @map("delivery_window_end") @db.Time(0)
  preferredTimeNote      String?   @map("preferred_time_note") @db.VarChar(200)
  serviceDurationMinutes Int?      @map("service_duration_minutes") @db.UnsignedInt
  allowEarlyDelivery     Boolean?  @map("allow_early_delivery")
  allowLateDelivery      Boolean?  @map("allow_late_delivery")
  timeWindowPriority     String?   @map("time_window_priority") @db.VarChar(16)
  /// general | patrol | replenishment | emergency（可空＝視為 general）
  orderKind              String?   @map("order_kind") @db.VarChar(24)
  /// normal | urgent | must
  dispatchPriority       String?   @map("dispatch_priority") @db.VarChar(16)
  earliestDate           DateTime? @map("earliest_date") @db.Date
  earliestShift          String?   @map("earliest_shift") @db.VarChar(8)
  latestDate             DateTime? @map("latest_date") @db.Date
  latestShift            String?   @map("latest_shift") @db.VarChar(8)
  preferredShift         String?   @map("preferred_shift") @db.VarChar(8)
  dispatchLocked         Boolean   @default(false) @map("dispatch_locked")
  preferredDriverId      BigInt?   @map("preferred_driver_id") @db.UnsignedBigInt
  requiredDriverId       BigInt?   @map("required_driver_id") @db.UnsignedBigInt
  subtotal               Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount            Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  lockVersion            Int       @default(0) @map("lock_version") @db.UnsignedInt
  remark                 String?   @db.Text
  /// 下單快照：客戶預設或 mixed（明細混用時）
  billingTypeAtOrder     String?   @map("billing_type_at_order") @db.VarChar(32)
  /// 明細中「現金」列金額合計（司機應收、現金立帳用）
  cashSubtotal           Decimal   @default(0) @map("cash_subtotal") @db.Decimal(14, 2)
  /// 明細中「月結」列金額合計（月結應收／沖銷上限）
  monthlySubtotal        Decimal   @default(0) @map("monthly_subtotal") @db.Decimal(14, 2)
  /// 已廢止：現金應收改由前期現金欠款＋本單總額與 FIFO 沖銷；欄位保留相容舊資料
  orderCashAdjustment    Decimal   @default(0) @map("order_cash_adjustment") @db.Decimal(14, 2)
  /// 月結：核銷完成日所屬曆月 YYYY-MM（報表／相容）
  billingPeriodKey       String?   @map("billing_period_key") @db.VarChar(7)
  /// 辦公室核銷送達完成時間（月結截止日篩選用）
  officeSettledAt        DateTime? @map("office_settled_at") @db.DateTime(3)
  /// 月結：已沖銷入帳累計（FIFO）；已清＝>= total_amount
  monthlyReceivedAmount  Decimal   @default(0) @map("monthly_received_amount") @db.Decimal(14, 2)
  /// 月結該筆訂單是否已全額沖完
  monthlyPeriodPaid      Boolean   @default(false) @map("monthly_period_paid")
  /// 預付桶儲值：核銷後待入帳桶數（本單現金 AR 全沖清後才加進 prepaid_barrel_balance）
  pendingPrepaidTopupBarrels Int   @default(0) @map("pending_prepaid_topup_barrels")
  /// 現金區塊發票：none | tax_inclusive | tax_exclusive（未稅金額即 line_amount；稅額見 tax_invoices）
  cashInvoiceMode        String?   @map("cash_invoice_mode") @db.VarChar(32)
  /// admin | liff
  source                 String    @default("admin") @db.VarChar(16)
  /// 測試資料標記；帳務報表預設排除
  isTest                 Boolean   @default(false) @map("is_test")
  /// 測試批次 ID（可選；清除測試批次用）
  testBatchId            String?   @map("test_batch_id") @db.VarChar(64)
  createdByUserId        BigInt?   @map("created_by_user_id") @db.UnsignedBigInt
  createdAt              DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer        Customer          @relation(fields: [customerId], references: [id])
  deliveryAddress DeliveryAddress   @relation(fields: [deliveryAddressId], references: [id])
  createdBy       User?             @relation("SalesOrderCreator", fields: [createdByUserId], references: [id])
  preferredDriver Driver?           @relation("OrderPreferredDriver", fields: [preferredDriverId], references: [id], onDelete: SetNull)
  requiredDriver  Driver?           @relation("OrderRequiredDriver", fields: [requiredDriverId], references: [id], onDelete: SetNull)
  lines           SalesOrderLine[]
  assignments     DeliveryAssignment[]
  routeStops      DeliveryRouteStop[]
  planUnassigned  DeliveryPlanUnassigned[]
  payments        Payment[]
  notificationLogs NotificationLog[]
  ledgerEntries   CustomerLedgerEntry[]
  arDocuments     ArDocument[]
  arOpenItems     ArOpenItem[]
  creditNotes     CreditNote[]
  billingStatementOrder BillingStatementOrder?
  taxInvoices          TaxInvoice[]
  floorBonusRecords    FloorDeliveryBonusRecord[]
  barrelMovements      BarrelMovement[]
  serviceTickets       ServiceTicket[]

  @@index([customerId, officeSettledAt])
  @@index([isTest])
  @@index([testBatchId, isTest])
  @@index([orderKind], map: "idx_so_order_kind")
  @@index([latestDate, latestShift], map: "idx_so_latest_shift")
  @@map("sales_orders")
}

/// 客戶帳務流水：現金往來、月結應收、預付桶等（amount 正＝客戶欠公司增加；barrel_delta 正＝預付桶增加）
model CustomerLedgerEntry {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId       BigInt    @map("customer_id") @db.UnsignedBigInt
  entryType        String    @map("entry_type") @db.VarChar(40)
  amount           Decimal   @default(0) @db.Decimal(14, 2)
  barrelDelta      Int       @default(0) @map("barrel_delta")
  salesOrderId     BigInt?   @map("sales_order_id") @db.UnsignedBigInt
  paymentId        BigInt?   @map("payment_id") @db.UnsignedBigInt
  receiptVoucherId BigInt?   @map("receipt_voucher_id") @db.UnsignedBigInt
  sourceType       String?   @map("source_type") @db.VarChar(40)
  sourceId         BigInt?   @map("source_id") @db.UnsignedBigInt
  note             String?   @db.VarChar(500)
  createdByUserId  BigInt?   @map("created_by_user_id") @db.UnsignedBigInt
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer   Customer    @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  receiptVoucher ReceiptVoucher? @relation(fields: [receiptVoucherId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("customer_ledger_entries")
}

model SalesOrderLine {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  salesOrderId BigInt   @map("sales_order_id") @db.UnsignedBigInt
  productId    BigInt   @map("product_id") @db.UnsignedBigInt
  qtyOrdered   Int      @map("qty_ordered")
  qtyDelivered Int      @default(0) @map("qty_delivered")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineAmount   Decimal  @map("line_amount") @db.Decimal(14, 2)
  /// 此列結帳方式：cash | monthly | prepaid（開單時選擇；null 則沿用舊單訂單層）
  billingTypeAtLine      String?   @map("billing_type_at_line") @db.VarChar(32)
  /// delivery：一般出貨；prepaid_barrel_topup：預付桶儲值（不出庫；現金應收沖清後入桶數）
  linePurpose            String    @default("delivery") @map("line_purpose") @db.VarChar(32)
  /// 發票模式（現金/儲值列）；null = 依訂單 cash_invoice_mode 或視為不開票
  invoiceMode            String?   @map("invoice_mode") @db.VarChar(32)
  isPromotionGift        Boolean   @default(false) @map("is_promotion_gift")
  promotionRuleKey       String?   @map("promotion_rule_key") @db.VarChar(50)
  promotionNote          String?   @map("promotion_note") @db.VarChar(200)
  /// 補送（破桶補水等）：預設免費；仍依商品 countsDepositBarrel 計入未收回空桶
  isReplenishment        Boolean   @default(false) @map("is_replenishment")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  floorBonusRecords FloorDeliveryBonusRecord[]

  @@map("sales_order_lines")
}

