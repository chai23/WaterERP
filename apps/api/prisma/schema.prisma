  billingStatement BillingStatement @relation(fields: [billingStatementId], references: [id], onDelete: Cascade)
  salesOrder       SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  @@index([billingStatementId])
  @@map("billing_statement_orders")
}

model TaxInvoice {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  invoiceNo            String    @unique @map("invoice_no") @db.VarChar(40)
  /// 實際發票號碼（財務系統開出後補登）
  externalInvoiceNo    String?   @map("external_invoice_no") @db.VarChar(20)
  customerId           BigInt    @map("customer_id") @db.UnsignedBigInt
  /// billing_statement | sales_order | prepayment_topup
  basisType            String    @map("basis_type") @db.VarChar(24)
  billingStatementId   BigInt?   @map("billing_statement_id") @db.UnsignedBigInt
  salesOrderId         BigInt?   @map("sales_order_id") @db.UnsignedBigInt
  receiptVoucherId     BigInt?   @map("receipt_voucher_id") @db.UnsignedBigInt
  invoiceMode          String    @default("tax_exclusive") @map("invoice_mode") @db.VarChar(32)
  untaxedAmount        Decimal   @default(0) @map("untaxed_amount") @db.Decimal(14, 2)
  taxAmount            Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  buyerTaxId           String?   @map("buyer_tax_id") @db.VarChar(16)
  buyerName            String?   @map("buyer_name") @db.VarChar(120)
  note                 String?   @db.Text
  taxRate              Decimal   @default(0.05) @map("tax_rate") @db.Decimal(8, 6)
  /// planned | issued | voided
  status               String    @default("planned") @map("status") @db.VarChar(24)
  issuedAt             DateTime  @default(now()) @map("issued_at") @db.DateTime(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer         Customer          @relation(fields: [customerId], references: [id])
  billingStatement BillingStatement? @relation(fields: [billingStatementId], references: [id], onDelete: SetNull)
  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  receiptVoucher   ReceiptVoucher?   @relation(fields: [receiptVoucherId], references: [id], onDelete: SetNull)

  @@index([customerId, issuedAt])
  @@index([billingStatementId])
  @@index([salesOrderId])
  @@index([receiptVoucherId])
  @@index([externalInvoiceNo])
  @@index([status])
  @@map("tax_invoices")
}

model ArOpenItem {
