model ArDocument {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  arNo             String   @unique @map("ar_no") @db.VarChar(40)
  customerId       BigInt   @map("customer_id") @db.UnsignedBigInt
  salesOrderId     BigInt?  @map("sales_order_id") @db.UnsignedBigInt
  /// 月結批次整包立帳時綁定（單筆應收 OpenItem 通常 sales_order_id 為 null）
  billingStatementId BigInt? @map("billing_statement_id") @db.UnsignedBigInt
  documentType     String   @default("delivery") @map("document_type") @db.VarChar(32)
  billingType      String   @map("billing_type") @db.VarChar(32)
  documentAmount   Decimal  @map("document_amount") @db.Decimal(14, 2)
  dueDate          DateTime? @map("due_date") @db.Date
  status           String   @default("open") @db.VarChar(24)
  postedAt         DateTime @default(now()) @map("posted_at") @db.DateTime(3)
  createdByUserId  BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customer   Customer   @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  billingStatement BillingStatement? @relation(fields: [billingStatementId], references: [id], onDelete: SetNull)
