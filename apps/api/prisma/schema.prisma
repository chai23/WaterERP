model DeliveryAssignment {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  salesOrderId         BigInt    @map("sales_order_id") @db.UnsignedBigInt
  driverId             BigInt    @map("driver_id") @db.UnsignedBigInt
  vehicleId            BigInt?   @map("vehicle_id") @db.UnsignedBigInt
  assignmentDate       DateTime  @map("assignment_date") @db.Date
  /// assigned | delivering | pending_settlement（司機已回報、待辦公室核銷）| completed | cancelled | not_delivered
  status               String    @default("assigned") @db.VarChar(32)
  assignedByUserId     BigInt?   @map("assigned_by_user_id") @db.UnsignedBigInt
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.DateTime(3)
  /// 辦公室核銷後寫入（與 office_settled_at 一致）；司機回報階段為 null
  completedAt          DateTime? @map("completed_at") @db.DateTime(3)
  /// 司機於司機端提交配送結果的時間
  driverReportedAt     DateTime? @map("driver_reported_at") @db.DateTime(3)
  emptyBarrelsReturned Int       @default(0) @map("empty_barrels_returned")
  cashReceived         Decimal   @default(0) @map("cash_received") @db.Decimal(14, 2)
  checkReceived        Decimal   @default(0) @map("check_received") @db.Decimal(14, 2)
  /// 核銷結果：not_delivered | delivered_cash_exact | delivered_cash_short | delivered_cash_over | delivered_no_cash（舊資料為 null）
  settlementOutcome    String?   @map("settlement_outcome") @db.VarChar(40)
  failureReason        String?   @map("failure_reason") @db.Text
  expectedAmount       Decimal?  @map("expected_amount") @db.Decimal(14, 2)
  cashVariance         Decimal?  @map("cash_variance") @db.Decimal(14, 2)
  settlementNote       String?   @map("settlement_note") @db.VarChar(500)
  /// 辦公室在後台按下「確認核銷」的時間；null 表示仍待核銷
  officeSettledAt      DateTime? @map("office_settled_at") @db.DateTime(3)
  /// 預計配送時段說明（派單時填寫，用於 LINE 推播）
  estimatedDeliverySlot String?  @map("estimated_delivery_slot") @db.VarChar(120)
  /// 預計配送時間點（選填）
  estimatedDeliveryAt  DateTime? @map("estimated_delivery_at") @db.DateTime(3)
  /// AI 方案發布後可選關聯（可空；人工派單維持 null）
  routeStopId          BigInt?   @map("route_stop_id") @db.UnsignedBigInt
  routeSequence        Int?      @map("route_sequence") @db.UnsignedInt
  assignmentShift      String?   @map("assignment_shift") @db.VarChar(8)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  salesOrder   SalesOrder        @relation(fields: [salesOrderId], references: [id])
  driver       Driver            @relation(fields: [driverId], references: [id])
  vehicle      Vehicle?          @relation(fields: [vehicleId], references: [id])
  assignedBy   User?             @relation("AssignmentAssigner", fields: [assignedByUserId], references: [id])
  routeStop    DeliveryRouteStop? @relation(fields: [routeStopId], references: [id], onDelete: SetNull)
  events       DeliveryEvent[]
  floorBonusRecords FloorDeliveryBonusRecord[]
  barrelMovements BarrelMovement[]
  notificationLogs NotificationLog[]

  @@index([routeStopId], map: "idx_da_route_stop")
  @@map("delivery_assignments")
}

/// LINE／對外推播紀錄
model NotificationLog {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  customerId           BigInt?   @map("customer_id") @db.UnsignedBigInt
  lineUserId           String?   @map("line_user_id") @db.VarChar(64)
  channel              String    @default("line") @db.VarChar(16)
  eventType            String    @map("event_type") @db.VarChar(40)
  salesOrderId         BigInt?   @map("sales_order_id") @db.UnsignedBigInt
  deliveryAssignmentId BigInt?   @map("delivery_assignment_id") @db.UnsignedBigInt
  payloadJson          Json?     @map("payload_json")
  status               String    @default("pending") @db.VarChar(20)
  errorMessage         String?   @map("error_message") @db.VarChar(500)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesOrder         SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  deliveryAssignment DeliveryAssignment? @relation(fields: [deliveryAssignmentId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([eventType, createdAt])
  @@map("notification_logs")
}

