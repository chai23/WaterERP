  returnDriverId         BigInt?   @map("return_driver_id") @db.UnsignedBigInt
  returnVehicleId        BigInt?   @map("return_vehicle_id") @db.UnsignedBigInt
  returnDate             DateTime? @map("return_date") @db.Date
  returnAssignedByUserId BigInt?   @map("return_assigned_by_user_id") @db.UnsignedBigInt
  returnAssignedAt       DateTime? @map("return_assigned_at") @db.DateTime(3)
  returnedAt             DateTime? @map("returned_at") @db.DateTime(3)
  /// cash | monthly
  billingType            String?   @map("billing_type") @db.VarChar(32)
  chargeAmount           Decimal?  @map("charge_amount") @db.Decimal(14, 2)
  salesOrderId           BigInt?   @unique @map("sales_order_id") @db.UnsignedBigInt
  /// 負責跟客戶收服務費的司機（現場＝評估司機；載回＝送回司機）
  collectorDriverId      BigInt?   @map("collector_driver_id") @db.UnsignedBigInt
  /// 司機日收款核對歸屬日
  collectionDate         DateTime? @map("collection_date") @db.Date
  /// 該司機回報帶回之現金／支票（可為 0＝客戶說下次再收）
  driverCashReceived     Decimal?  @map("driver_cash_received") @db.Decimal(14, 2)
  driverCheckReceived    Decimal?  @map("driver_check_received") @db.Decimal(14, 2)
  closedAt               DateTime? @map("closed_at") @db.DateTime(3)
  cancelledReason        String?   @map("cancelled_reason") @db.VarChar(500)
  /// liff | admin
  source                 String    @default("liff") @db.VarChar(16)
  createdAt              DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  customer            Customer        @relation(fields: [customerId], references: [id])
  deliveryAddress     DeliveryAddress @relation(fields: [deliveryAddressId], references: [id])
  acceptedBy          User?           @relation("ServiceTicketAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  assessDriver        Driver?         @relation("ServiceTicketAssessDriver", fields: [assessDriverId], references: [id], onDelete: SetNull)
  assessVehicle       Vehicle?        @relation("ServiceTicketAssessVehicle", fields: [assessVehicleId], references: [id], onDelete: SetNull)
  assessAssignedBy    User?           @relation("ServiceTicketAssessAssigner", fields: [assessAssignedByUserId], references: [id], onDelete: SetNull)
  workshopUpdatedBy   User?           @relation("ServiceTicketWorkshopUpdater", fields: [workshopUpdatedByUserId], references: [id], onDelete: SetNull)
  returnDriver        Driver?         @relation("ServiceTicketReturnDriver", fields: [returnDriverId], references: [id], onDelete: SetNull)
  returnVehicle       Vehicle?        @relation("ServiceTicketReturnVehicle", fields: [returnVehicleId], references: [id], onDelete: SetNull)
  returnAssignedBy    User?           @relation("ServiceTicketReturnAssigner", fields: [returnAssignedByUserId], references: [id], onDelete: SetNull)
  salesOrder          SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  collectorDriver     Driver?         @relation("ServiceTicketCollectorDriver", fields: [collectorDriverId], references: [id], onDelete: SetNull)
  events              ServiceTicketEvent[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([assessDriverId, assessDate])
  @@index([collectorDriverId, collectionDate])
  @@map("service_tickets")
}

model ServiceTicketEvent {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  serviceTicketId  BigInt   @map("service_ticket_id") @db.UnsignedBigInt
  eventType        String   @map("event_type") @db.VarChar(40)
  payloadJson      Json?    @map("payload_json")
  createdByUserId  BigInt?  @map("created_by_user_id") @db.UnsignedBigInt
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  serviceTicket ServiceTicket @relation(fields: [serviceTicketId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("ServiceTicketEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([serviceTicketId])
  @@map("service_ticket_events")
}

/// 操作稽核：開單／改數量／司機回報／核銷等（誰／何時／前後 JSON）
model OperationAuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorUserId  BigInt?  @map("actor_user_id") @db.UnsignedBigInt
  action       String   @db.VarChar(64)
  entityType   String?  @map("entity_type") @db.VarChar(64)
  entityId     String?  @map("entity_id") @db.VarChar(64)
  beforeJson   Json?    @map("before_json")
  afterJson    Json?    @map("after_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation("OperationAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("operation_audit_logs")
}

/// 每日關帳鎖定（P5）：unlocked_at IS NULL 表示該營業日目前鎖定
model DayCloseLock {
  businessDate     DateTime  @id @map("business_date") @db.Date
  lockedAt         DateTime  @map("locked_at") @db.DateTime(3)
  lockedByUserId   BigInt    @map("locked_by_user_id") @db.UnsignedBigInt
  unlockedAt       DateTime? @map("unlocked_at") @db.DateTime(3)
  unlockedByUserId BigInt?   @map("unlocked_by_user_id") @db.UnsignedBigInt
  note             String?   @db.VarChar(500)

  lockedBy   User  @relation("DayCloseLocker", fields: [lockedByUserId], references: [id])
  unlockedBy User? @relation("DayCloseUnlocker", fields: [unlockedByUserId], references: [id], onDelete: SetNull)

  @@map("day_close_locks")
}

/// AI 派單設定（key-value）
model DeliveryPlanningSetting {
  settingKey       String   @id @map("setting_key") @db.VarChar(100)
  settingValue     String   @map("setting_value") @db.Text
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedByUserId  BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt

  updatedBy User? @relation("DeliveryPlanningSettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("delivery_planning_settings")
}

model DeliveryPlanningAuditLog {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  planId         BigInt?  @map("plan_id") @db.UnsignedBigInt
  action         String   @db.VarChar(64)
  modelVersion   String?  @map("model_version") @db.VarChar(64)
  promptVersion  String?  @map("prompt_version") @db.VarChar(64)
  inputSummary   Json?    @map("input_summary")
  outputSummary  Json?    @map("output_summary")
  actorUserId    BigInt?  @map("actor_user_id") @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  plan  DeliveryPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  actor User?         @relation("DeliveryPlanningAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([planId], map: "idx_dpal_plan")
  @@index([action, createdAt], map: "idx_dpal_action_created")
  @@index([actorUserId], map: "idx_dpal_actor")
  @@map("delivery_planning_audit_logs")
}

model DeliveryPlan {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  planDate            DateTime  @map("plan_date") @db.Date
  /// am | pm | all
  shift               String    @default("all") @db.VarChar(8)
  version             Int       @default(1) @db.UnsignedInt
  status              String    @default("draft") @db.VarChar(32)
  mode                String    @default("suggest_driver") @db.VarChar(32)
  algorithmVersion    String?   @map("algorithm_version") @db.VarChar(64)
  weightProfileKey    String?   @map("weight_profile_key") @db.VarChar(100)
  totalDistanceMeters Int?      @map("total_distance_meters") @db.UnsignedInt
  totalDriveMinutes   Int?      @map("total_drive_minutes") @db.UnsignedInt
  unassignedCount     Int       @default(0) @map("unassigned_count") @db.UnsignedInt
  createdByUserId     BigInt?   @map("created_by_user_id") @db.UnsignedBigInt
  approvedByUserId    BigInt?   @map("approved_by_user_id") @db.UnsignedBigInt
  publishedAt         DateTime? @map("published_at") @db.DateTime(3)
  computeStartedAt    DateTime? @map("compute_started_at") @db.DateTime(3)
  computeFinishedAt   DateTime? @map("compute_finished_at") @db.DateTime(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  createdBy  User? @relation("DeliveryPlanCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("DeliveryPlanApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  routes     DeliveryRoute[]
  unassigned DeliveryPlanUnassigned[]
  auditLogs  DeliveryPlanningAuditLog[]

  @@unique([planDate, shift, version], map: "uk_delivery_plans_date_shift_version")
  @@index([planDate, status], map: "idx_delivery_plans_date_status")
  @@map("delivery_plans")
}

model DeliveryRoute {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  planId              BigInt    @map("plan_id") @db.UnsignedBigInt
  driverId            BigInt    @map("driver_id") @db.UnsignedBigInt
  vehicleId           BigInt?   @map("vehicle_id") @db.UnsignedBigInt
  sequenceNo          Int       @default(1) @map("sequence_no") @db.UnsignedInt
  departureAt         DateTime? @map("departure_at") @db.DateTime(3)
  returnAt            DateTime? @map("return_at") @db.DateTime(3)
  totalDistanceMeters Int?      @map("total_distance_meters") @db.UnsignedInt
  totalDriveMinutes   Int?      @map("total_drive_minutes") @db.UnsignedInt
  totalBarrelQty      Int       @default(0) @map("total_barrel_qty") @db.UnsignedInt
  riskScore           Decimal?  @map("risk_score") @db.Decimal(8, 2)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  plan    DeliveryPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  driver  Driver               @relation(fields: [driverId], references: [id])
  vehicle Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops   DeliveryRouteStop[]

  @@unique([planId, driverId], map: "uk_delivery_routes_plan_driver")
  @@map("delivery_routes")
}

model DeliveryRouteStop {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  routeId              BigInt    @map("route_id") @db.UnsignedBigInt
  salesOrderId         BigInt    @map("sales_order_id") @db.UnsignedBigInt
  stopSequence         Int       @map("stop_sequence") @db.UnsignedInt
  etaAt                DateTime? @map("eta_at") @db.DateTime(3)
  etdAt                DateTime? @map("etd_at") @db.DateTime(3)
  prevDistanceMeters   Int?      @map("prev_distance_meters") @db.UnsignedInt
  prevDriveMinutes     Int?      @map("prev_drive_minutes") @db.UnsignedInt
  windowStart          DateTime? @map("window_start") @db.Time(0)
  windowEnd            DateTime? @map("window_end") @db.Time(0)
  hasHardViolation     Boolean   @default(false) @map("has_hard_violation")
  violationCodesJson   Json?     @map("violation_codes_json")
  aiExplanation        String?   @map("ai_explanation") @db.Text
  manualAdjustReason   String?   @map("manual_adjust_reason") @db.VarChar(500)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  route      DeliveryRoute         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder            @relation(fields: [salesOrderId], references: [id])
  assignments DeliveryAssignment[]

  @@unique([routeId, stopSequence], map: "uk_route_stop_sequence")
  @@unique([routeId, salesOrderId], map: "uk_route_stop_order")
  @@index([salesOrderId], map: "idx_route_stops_order")
  @@map("delivery_route_stops")
}

model DeliveryPlanUnassigned {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  planId       BigInt   @map("plan_id") @db.UnsignedBigInt
  salesOrderId BigInt   @map("sales_order_id") @db.UnsignedBigInt
  reasonCode   String   @map("reason_code") @db.VarChar(64)
  reasonText   String?  @map("reason_text") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  plan       DeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder   @relation(fields: [salesOrderId], references: [id])

  @@unique([planId, salesOrderId], map: "uk_plan_unassigned_order")
  @@index([salesOrderId], map: "idx_plan_unassigned_order")
  @@map("delivery_plan_unassigned")
}
