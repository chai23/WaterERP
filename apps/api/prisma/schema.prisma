/// 月結結帳批次（R2：於此前不立訂單月結 AR）
model BillingStatement {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  statementNo    String    @unique @map("statement_no") @db.VarChar(40)
  customerId     BigInt    @map("customer_id") @db.UnsignedBigInt
  status         String    @default("posted") @map("status") @db.VarChar(24)
  cutoffDate     DateTime? @map("cutoff_date") @db.Date
  untaxedTotal   Decimal   @map("untaxed_total") @db.Decimal(14, 2)
  taxAmount      Decimal   @map("tax_amount") @db.Decimal(14, 2)
  totalWithTax   Decimal   @map("total_with_tax") @db.Decimal(14, 2)
  taxRate        Decimal   @default(0.05) @map("tax_rate") @db.Decimal(8, 6)
  invoiceMode    String    @default("tax_exclusive") @map("invoice_mode") @db.VarChar(32)
  postedAt       DateTime  @default(now()) @map("posted_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  customer    Customer                @relation(fields: [customerId], references: [id])
  orders      BillingStatementOrder[]
  arDocuments ArDocument[]
  taxInvoices TaxInvoice[]

  @@index([customerId, postedAt])
  @@map("billing_statements")
}

model BillingStatementOrder {
  id                   BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  billingStatementId   BigInt   @map("billing_statement_id") @db.UnsignedBigInt
  salesOrderId         BigInt   @unique @map("sales_order_id") @db.UnsignedBigInt
